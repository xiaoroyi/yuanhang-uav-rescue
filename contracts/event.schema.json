{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yuanhang.example/contracts/event.schema.json",
  "title": "event",
  "description": "Implementation draft 0.1.0-draft; additive zero-time battery withdrawal, RFC-010; pending A/B review.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "0.1.0-draft"
        },
        "event_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "scenario_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "expected_state_version": {
          "type": "integer",
          "minimum": 1
        },
        "event_type": {
          "const": "drone.unavailable"
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "received_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "effective_time_s": {
          "type": "number",
          "minimum": 0
        },
        "actor": {
          "enum": [
            "simulation",
            "operator"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "payload": {
          "type": "object",
          "properties": {
            "drone_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            }
          },
          "required": [
            "drone_id"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema_version",
        "event_id",
        "scenario_id",
        "expected_state_version",
        "event_type",
        "occurred_at",
        "received_at",
        "effective_time_s",
        "actor",
        "reason",
        "payload"
      ],
      "additionalProperties": false,
      "title": "DroneUnavailableEvent"
    },
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "0.1.0-draft"
        },
        "event_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "scenario_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "expected_state_version": {
          "type": "integer",
          "minimum": 1
        },
        "event_type": {
          "const": "battery.unavailable"
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "received_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "effective_time_s": {
          "type": "number",
          "minimum": 0
        },
        "actor": {
          "enum": [
            "simulation",
            "operator"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "payload": {
          "type": "object",
          "properties": {
            "battery_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            }
          },
          "required": [
            "battery_id"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema_version",
        "event_id",
        "scenario_id",
        "expected_state_version",
        "event_type",
        "occurred_at",
        "received_at",
        "effective_time_s",
        "actor",
        "reason",
        "payload"
      ],
      "additionalProperties": false,
      "title": "BatteryUnavailableEvent"
    }
  ]
}
