{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yuanhang.example/contracts/weather.schema.json",
  "title": "WeatherContext",
  "description": "RFC-019: explicit uniform manual scenario, operating thresholds and window only; no wind energy calibration or real observation claim.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "model_id": {
      "const": "manual_operating_window_v1"
    },
    "weather_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "source_kind": {
      "const": "manual_scenario"
    },
    "source_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "issued_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "valid_from_s": {
      "type": "number",
      "minimum": 0
    },
    "valid_until_s": {
      "type": "number",
      "minimum": 0
    },
    "height_m": {
      "type": "number",
      "minimum": 0,
      "maximum": 20000
    },
    "height_reference": {
      "const": "AGL"
    },
    "wind_speed_mps": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 200
        },
        {
          "type": "null"
        }
      ]
    },
    "gust_mps": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 200
        },
        {
          "type": "null"
        }
      ]
    },
    "wind_direction_from_deg": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 360
        },
        {
          "type": "null"
        }
      ]
    },
    "temperature_c": {
      "anyOf": [
        {
          "type": "number",
          "minimum": -100,
          "maximum": 100
        },
        {
          "type": "null"
        }
      ]
    },
    "precipitation_mm_h": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1000
        },
        {
          "type": "null"
        }
      ]
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "https://yuanhang.example/contracts/weather.schema.json#/$defs/WeatherRule"
      }
    }
  },
  "required": [
    "model_id",
    "weather_id",
    "source_kind",
    "source_ref",
    "issued_at",
    "valid_from_s",
    "valid_until_s",
    "height_m",
    "height_reference",
    "wind_speed_mps",
    "gust_mps",
    "wind_direction_from_deg",
    "temperature_c",
    "precipitation_mm_h",
    "rules"
  ],
  "$defs": {
    "WeatherRule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type_id": {
          "type": "string",
          "minLength": 1
        },
        "source_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "max_wind_mps": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 200
            },
            {
              "type": "null"
            }
          ]
        },
        "max_gust_mps": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 200
            },
            {
              "type": "null"
            }
          ]
        },
        "min_temperature_c": {
          "anyOf": [
            {
              "type": "number",
              "minimum": -100,
              "maximum": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "max_temperature_c": {
          "anyOf": [
            {
              "type": "number",
              "minimum": -100,
              "maximum": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "max_precipitation_mm_h": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1000
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "type_id",
        "source_ref",
        "max_wind_mps",
        "max_gust_mps",
        "min_temperature_c",
        "max_temperature_c",
        "max_precipitation_mm_h"
      ]
    }
  }
}
