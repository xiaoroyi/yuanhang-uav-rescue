{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yuanhang.example/contracts/snapshot.schema.json",
  "title": "snapshot",
  "description": "G0 review draft 0.1.0-draft; not an approved or implemented V1 contract.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1.0-draft"
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "scenario_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "scenario_state_version": {
      "type": "integer",
      "minimum": 1
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "scenario": {
      "$ref": "https://yuanhang.example/contracts/scenario.schema.json"
    }
  },
  "required": [
    "schema_version",
    "snapshot_id",
    "scenario_id",
    "scenario_state_version",
    "content_hash",
    "created_at",
    "scenario"
  ],
  "additionalProperties": false
}
