{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yuanhang.example/contracts/heuristic-artifact.schema.json",
  "title": "heuristic-artifact",
  "description": "RFC-032 offline scalar ranking package; local validation does not certify the provider's evolution claims.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {"const": "yuanhang-scalar-v1"},
    "policy_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,80}$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 120},
    "version": {"type": "string", "minLength": 1, "maxLength": 40},
    "origin": {"enum": ["rule_initialization", "eoh_offline"]},
    "description": {"type": "string", "minLength": 1, "maxLength": 1200},
    "expression": {"type": "string", "minLength": 1, "maxLength": 1800},
    "evolution_record": {"type": ["object", "null"], "default": null}
  },
  "required": ["format", "policy_id", "name", "version", "origin", "description", "expression"]
}
