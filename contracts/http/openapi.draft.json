  "components": {
    "schemas": {
      "scenario": {
        "$ref": "https://yuanhang.example/contracts/scenario.schema.json"
      },
      "snapshot": {
        "$ref": "https://yuanhang.example/contracts/snapshot.schema.json"
      },
      "plan": {
        "$ref": "https://yuanhang.example/contracts/plan.schema.json"
      },
      "event": {
        "$ref": "https://yuanhang.example/contracts/event.schema.json"
      },
      "solver-options": {
        "$ref": "https://yuanhang.example/contracts/solver-options.schema.json"
      },
      "solver-outcome": {
        "$ref": "https://yuanhang.example/contracts/solver-outcome.schema.json"
      },
      "solve-job": {
        "$ref": "https://yuanhang.example/contracts/solve-job.schema.json"
      },
      "error": {
        "$ref": "https://yuanhang.example/contracts/error.schema.json"
      },
      "capabilities": {
        "$ref": "https://yuanhang.example/contracts/capabilities.schema.json"
      },
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "enum": [
              "ok",
              "not_ready"
            ]
          },
          "service_version": {
            "type": "string",
            "minLength": 1
          },
          "solver_ready": {
            "type": "boolean"
          }
        },
        "required": [
          "status",
          "service_version",
          "solver_ready"
        ],
        "additionalProperties": false
      },
      "VersionRequest": {
        "type": "object",
        "properties": {
          "expected_state_version": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "expected_state_version"
        ],
        "additionalProperties": false
      },
      "ConfirmRequest": {
        "type": "object",
        "properties": {
          "expected_state_version": {
            "type": "integer",
            "minimum": 1
          },
          "idempotency_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          }
        },
        "required": [
          "expected_state_version",
          "idempotency_key"
        ],
        "additionalProperties": false
      },
      "Confirmation": {
        "type": "object",
        "properties": {
          "plan_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "scenario_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "state_version": {
            "type": "integer",
            "minimum": 1
          },
          "confirmation_state": {
            "const": "confirmed"
          },
          "confirmed_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
          }
        },
        "required": [
          "plan_id",
          "scenario_id",
          "state_version",
          "confirmation_state",
          "confirmed_at"
        ],
        "additionalProperties": false
      },
      "EventReceipt": {
        "type": "object",
        "properties": {
          "event": {
            "$ref": "https://yuanhang.example/contracts/event.schema.json"
          },
          "state_version_after": {
            "type": "integer",
            "minimum": 1
          },
          "applied": {
            "type": "boolean"
          }
        },
        "required": [
          "event",
          "state_version_after",
          "applied"
        ],
        "additionalProperties": false
      },
      "SolveRequest": {
        "type": "object",
        "properties": {
          "snapshot_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "objective": {
            "enum": [
              "time",
              "energy",
              "balanced"
            ]
          },
          "mode": {
            "enum": [
              "quick",
              "improve",
              "replan"
            ]
          },
          "time_limit_s": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "seed": {
            "type": "integer",
            "minimum": 0
          },
          "parent_plan_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
              },
              {
                "type": "null"
              }
            ]
          },
          "event_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
              },
              {
                "type": "null"
              }
            ]
          },
          "requested_model_scope": {
            "type": "array",
            "items": {
              "enum": [
                "cargo_unique",
                "capacity",
                "inventory",
                "aircraft",
                "battery",
                "time_window",
                "energy",
                "terrain",
                "communication"
              ]
            },
            "uniqueItems": true
          },
          "allow_partial_service": {
            "const": false
          }
        },
        "required": [
          "snapshot_id",
          "objective",
          "mode",
          "time_limit_s",
          "seed",
          "parent_plan_id",
          "event_id",
          "requested_model_scope",
          "allow_partial_service"
        ],
        "additionalProperties": false
      }
    }
  }
}
