{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yuanhang.example/contracts/common.schema.json",
  "title": "common",
  "description": "G0 review draft 0.1.0-draft; not an approved or implemented V1 contract.",
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "datetime": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "coordinates": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "scope": {
      "type": "array",
      "items": {
        "enum": [
          "cargo_unique",
          "capacity",
          "inventory",
          "aircraft",
          "battery",
          "time_window",
          "energy",
          "terrain",
          "communication",
          "restricted_zone"
        ]
      },
      "uniqueItems": true
    },
    "validation": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "passed",
            "failed",
            "partial",
            "not_run"
          ]
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "enum": [
                  "cargo_unique",
                  "capacity",
                  "inventory",
                  "aircraft",
                  "battery",
                  "time_window",
                  "energy",
                  "terrain",
                  "communication",
                  "restricted_zone"
                ]
              },
              "status": {
                "enum": [
                  "passed",
                  "failed",
                  "not_evaluated"
                ]
              },
              "object_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "message": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "code",
              "status",
              "object_id",
              "message"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        }
      },
      "required": [
        "status",
        "checks"
      ],
      "additionalProperties": false
    },
    "solver_status": {
      "enum": [
        "OPTIMAL",
        "FEASIBLE",
        "INFEASIBLE",
        "UNKNOWN",
        "ERROR"
      ]
    },
    "diagnostic": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "field_path": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "object_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "code",
        "message",
        "field_path",
        "object_id"
      ],
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "enum": [
            "SCHEMA_INVALID",
            "REFERENCE_INVALID",
            "RESOURCE_CONFLICT",
            "STATE_VERSION_CONFLICT",
            "SNAPSHOT_STALE",
            "UNSUPPORTED_SCOPE",
            "INPUT_NOT_READY",
            "NO_VALIDATED_PLAN",
            "UNSUPPORTED_EVENT_STATE",
            "SOLVER_BUSY",
            "CANCELED",
            "EXTERNAL_ASSET_UNAVAILABLE",
            "INTERNAL_ERROR"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "field_path": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "details": {
          "type": "object"
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        }
      },
      "required": [
        "code",
        "message",
        "field_path",
        "details",
        "request_id"
      ],
      "additionalProperties": false
    }
  }
}
