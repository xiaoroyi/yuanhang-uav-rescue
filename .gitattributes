* text=auto
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.txt text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.css text eol=lf
*.cmd text eol=crlf
*.docx binary
*.xlsx binary
*.pdf binary
*.zip binary
*.mat binary
*.tif binary

# Preserve source originals byte-for-byte, including historical CRLF/BOM/Markdown breaks.
# Whitespace in immutable source documents is not a change to repair.
references/** -text -whitespace
