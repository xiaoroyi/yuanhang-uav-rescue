# Optional shell/IDE environment values. The application does not auto-load .env.
# In PowerShell: $env:YUANHANG_RUNTIME = '.\runtime'
# Defaults already work without setting anything. Do not put secrets in Git.
YUANHANG_RUNTIME=./runtime
# Frontend development proxy (production uses the same-origin local API):
YUANHANG_API_URL=http://127.0.0.1:8000
